# ─────────────────────────────────────────────────────────────────────────────
# .env.airflow  —  copy to .env on the airflow-server (/opt/bq-pipeline/.env)
# All required values are marked [REQUIRED]; others have sensible defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── Airflow metadata database (managed PostgreSQL on DigitalOcean) ─────────
# [REQUIRED] Full DSN for the airflow-metadata-db cluster
# Format: postgresql+psycopg2://user:password@host:port/dbname?sslmode=require
AIRFLOW_METADATA_DSN=postgresql+psycopg2://doadmin:CHANGE_ME@airflow-metadata-db-do-user-31966335-0.g.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# ── Airflow security ───────────────────────────────────────────────────────
# [REQUIRED] Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME_generate_fernet_key

# [REQUIRED] Random secret for the webserver session cookie
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME_random_32_chars

# ── Airflow admin user ─────────────────────────────────────────────────────
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_strong_password  # [REQUIRED]

# ── Warehouse database (the analytics PostgreSQL, warehouse-db) ────────────
# [REQUIRED] psycopg3 DSN (no +psycopg2 prefix)
WAREHOUSE_DSN=postgresql://doadmin:CHANGE_ME@warehouse-db-do-user-31966335-0.g.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# ── Google BigQuery ────────────────────────────────────────────────────────
# [REQUIRED] GCP project that owns the BigQuery dataset
BQ_PROJECT=your-gcp-project-id

# Dataset to auto-discover tables from (used if BQ_TABLE_MANIFEST Airflow Variable is not set)
BQ_DATASET=your_bq_dataset

# Path inside the container where the service-account JSON key is mounted
# Mount the key by placing bigquery-sa.json in ./credentials/ on the server
BQ_CREDENTIALS_PATH=/opt/airflow/credentials/bigquery-sa.json

# Alternative: embed the entire service-account JSON as a string (base64 or raw JSON)
# Leave blank if using the file path above
BQ_CREDENTIALS_JSON=

# ── Transfer tuning ────────────────────────────────────────────────────────
# Rows streamed per BigQuery page / PostgreSQL executemany batch
BQ_CHUNK_ROWS=50000

# Days to look back when no watermark is stored (safety net for incremental DAG)
BQ_INCREMENTAL_LOOKBACK_DAYS=3

# ── Docker image ───────────────────────────────────────────────────────────
AIRFLOW_IMAGE=apache/airflow:3.1.8-python3.12
